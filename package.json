{
  "name": "mcpdatabase",
  "version": "1.0.0",
  "description": "An MCP server to connect to PostgreSQL database via SSH and execute queries",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node test-connection.js",
    "test:connection": "node test-connection.js",
    "test:context": "node test-context-features.js",
    "claude-bridge": "node claude-code-bridge-server.cjs",
    "electron:dev": "cd electron-app && npm run dev",
    "electron:build": "cd electron-app && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9"
  },
  "author": "",
  "license": "ISC"
}
