# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# SSH Tunnel Configuration (if connecting via SSH)
SSH_HOST=your_ssh_host
SSH_PORT=22
SSH_USERNAME=your_ssh_username

# SSH Authentication Method - Choose ONE of the following:
# Option 1: Password-based authentication
SSH_AUTH_METHOD=password
SSH_PASSWORD=your_ssh_password

# Option 2: Key-based authentication (comment out password above if using this)
# SSH_AUTH_METHOD=key
# SSH_PRIVATE_KEY_PATH=~/.ssh/id_rsa
# SSH_PASSPHRASE=your_ssh_passphrase  # Optional: only if your private key has a passphrase

# MCP Server Configuration
MCP_SERVER_NAME=postgresql-mcp-server
MCP_SERVER_VERSION=1.0.0 